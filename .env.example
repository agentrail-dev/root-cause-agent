# Fournis par Aiven (ne jamais committer de vraies valeurs)
CLICKHOUSE_URL=https://avnadmin:CHANGEME@clickhouse-xxx.aivencloud.com:12345
OPENSEARCH_URL=https://avnadmin:CHANGEME@opensearch-xxx.aivencloud.com:12345
POSTGRES_URL=postgres://avnadmin:CHANGEME@pg-xxx.aivencloud.com:12345/defaultdb?sslmode=require
ANTHROPIC_API_KEY=sk-ant-CHANGEME
ANTHROPIC_MODEL=claude-sonnet-5-5

# Watchdog : surveillance continue + diagnostic automatique des nouveaux incidents
WATCHDOG=false
WATCHDOG_INTERVAL=60
# Optionnel : notification (Slack / Mattermost) du message de cause racine
SLACK_WEBHOOK_URL=

# Repli : résultats pré-calculés (backend/fixtures/*.json), aucune base requise
DEMO_MODE=false
